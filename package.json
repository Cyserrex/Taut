{
  "name": "taut",
  "version": "1.6.5",
  "description": "Kendalikan YouTube Music di browser PC dari HP kamu lewat WiFi lokal.",
  "main": "server/index.js",
  "type": "commonjs",
  "bin": {
    "taut": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --verbose",
    "test": "node test/qr.test.js && node test/page.test.js && node test/server.test.js",
    "mock": "node test/mock-host.js",
    "build:ext": "node build/extension.js",
    "lint:ext": "node build/extension.js && npx --yes web-ext@8 lint --source-dir=dist/firefox --self-hosted",
    "sign:firefox": "node build/extension.js && node build/sign-firefox.js",
    "pack:firefox": "node build/pack-firefox.js",
    "autostart": "node build/autostart.js install",
    "autostart:off": "node build/autostart.js uninstall",
    "autostart:status": "node build/autostart.js status",
    "info": "node server/info.js",
    "build:exe": "node windows/build.js",
    "test:exe": "node windows/build.js && node test/server.test.js --exe",
    "build:icon": "node windows/make-icon.js"
  },
  "keywords": [
    "youtube-music",
    "remote",
    "websocket",
    "chrome-extension",
    "lan"
  ],
  "author": "Cyserrex",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
