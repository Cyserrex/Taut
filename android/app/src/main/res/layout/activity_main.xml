<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/taut_bg"
    android:fitsSystemWindows="true">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/taut_bg" />

    <!-- Ditampilkan saat PC tidak bisa dihubungi; WebView di belakang tetap
         hidup supaya lagu yang sedang tampil tidak hilang begitu saja. -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/taut_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/offlineSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/lost_server"
            android:textColor="@color/taut_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offlineHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/lost_server_hint"
            android:textColor="@color/taut_text_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/offlineRetry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_button"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/offlineForget"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:text="@string/forget"
            android:textAllCaps="false"
            android:textColor="@color/taut_text_faint"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
