{
  "manifest_version": 3,
  "name": "Taut — Remote YouTube Music",
  "short_name": "Taut",
  "version": "1.0.0",
  "description": "Menghubungkan YouTube Music di Chrome dengan remote Taut di HP kamu lewat WiFi lokal.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Taut",
    "default_popup": "popup.html"
  }
}
